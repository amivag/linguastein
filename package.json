{
  "name": "linguastein-app",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "description": "Mobile-first, local-first language practice app. Spanish first.",
  "license": "AGPL-3.0-only",
  "author": "amivag",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "tsx scripts/validate-datasets.ts",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run validate:data && npm run format:check",
    "build:data": "tsx scripts/build-dataset.ts",
    "build:palette": "tsx scripts/build-palette.ts",
    "review:data": "tsx scripts/review-dataset.ts",
    "generate:audio": "tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^1.33.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.18.2",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.11.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^4.1.10"
  }
}
