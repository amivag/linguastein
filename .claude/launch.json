{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "linguastein-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "linguastein-preview-root",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "-w",
        "linguastein-app",
        "--",
        "--outDir",
        ".tmp-cf",
        "--port",
        "4175",
        "--strictPort"
      ],
      "env": {
        "DEPLOY_TARGET": "cloudflare",
        "APP_BASE_PATH": "/"
      },
      "port": 4175
    },
    {
      "name": "linguastein-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "-w", "linguastein-app"],
      "port": 4173,
      "autoPort": true
    }
  ]
}
