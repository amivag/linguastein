# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# test / tooling caches
coverage/
.vite/
.eslintcache
*.tsbuildinfo

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# os
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# env
.env
.env.*
!.env.example

# generated PWA assets (produced by vite-plugin-pwa at build time)
dev-dist/

# candidate voices under comparison — throwaway, several voices' worth of the
# same twenty phrases (docs/tasks/canonical-audio.md §4.1)
audio-samples/

# a TTS toolchain, if one is ever set up here. No engine is chosen yet
# (docs/tasks/canonical-audio.md §4.0); these are listed so a local experiment
# can never be committed by accident. Keep any such toolchain project-local, and
# note that package caches must sit OUTSIDE the repo — something in this folder
# holds handles on new files and breaks atomic renames.
.tools/
.venv/
.tts-models/

# generated clips. Deliberately ignored while a voice is still being chosen:
# clips are content-addressed, so every regeneration is a new blob that would
# stay in history for ever. Un-ignore when the voice is settled and shipping.
public/packs/*/audio/
