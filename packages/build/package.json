    "check": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "peerDependencies": {
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.89.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
