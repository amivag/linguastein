{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["coverage", "node_modules"],
  "rules": {
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "eqeqeq": ["error", "smart"]
  },
  "overrides": [
    {
      /*
       * The appearance core is shared by every app, so it may depend on nothing:
       * no framework, no browser, no Node and no package. `tsconfig.src.json`
       * compiles it without DOM or Node types; this catches the imports.
       */
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!./*", "!../*"],
                "message": "The appearance core imports nothing outside itself: each app passes in its namespace, catalog and host."
              }
            ]
          }
        ]
      }
    }
  ]
}
