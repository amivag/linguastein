{
  "name": "linguastein-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace for Linguastein and the shared platform its apps are built on.",
  "license": "AGPL-3.0-only",
  "author": "amivag",
  "engines": {
    "node": ">=26.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w linguastein-app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check --workspaces --if-present && npm run format:check",
    "build:data": "npm run build:data -w linguastein-app --",
    "validate:data": "npm run validate:data -w linguastein-app",
    "review:data": "npm run review:data -w linguastein-app --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.5",
    "glob@^11.0.0": "^14.0.4"
  }
}
