{
  "name": "@platform/build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build rules every app shares: content security policy, host headers, deployment settings and the Vite plugins that apply them.",
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
