# Supply-chain defaults for everyone who installs this project, CI included.
# They were only in one developer's user config before, so CI ran without them.

# No package runs code at install time. Nothing here needs it: native tools
# (rolldown, oxlint, sharp) ship prebuilt binaries as optional dependencies.
ignore-scripts=true

# Resolve only releases at least seven days old, so a hijacked publish has time
# to be caught and pulled before it can reach this tree.
min-release-age=7

engine-strict=true
