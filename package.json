{
  "name": "linguastein-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace for Linguastein and the shared platform its apps are built on.",
  "license": "AGPL-3.0-only",
  "author": "amivag",
  "engines": {
    "node": ">=26.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w linguastein-app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check --workspaces --if-present && npm run format:check",
    "build:data": "npm run build:data -w linguastein-app --",
    "validate:data": "npm run validate:data -w linguastein-app",
    "review:data": "npm run review:data -w linguastein-app --"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
